# Set these in Netlify: Site configuration > Environment variables. NEVER commit real values.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated admin emails. A verified account with one of these emails becomes admin automatically (default: atarafatyt1@gmail.com).
ADMIN_EMAILS=atarafatyt1@gmail.com


# Backblaze B2 file storage (S3-compatible). Keep the real values ONLY in Netlify env vars.
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_BUCKET=ARXMine
B2_KEY_ID=
B2_APPLICATION_KEY=

# Owner admin account (email = first ADMIN_EMAILS entry). Logging in with it creates/repairs the admin account automatically.
ADMIN_PASSWORD=
