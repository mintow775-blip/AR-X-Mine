{
 "rules": {
  ".read": false,
  ".write": false,
  "users": {
   ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')",
   "$uid": {
    ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com'))",
    "username": {
     ".write": "auth != null && auth.uid === $uid && !data.exists()",
     ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
    },
    "email": {
     ".write": "auth != null && auth.uid === $uid && !data.exists()",
     ".validate": "newData.val() === auth.token.email"
    },
    "createdAt": {
     ".write": "auth != null && auth.uid === $uid && !data.exists()",
     ".validate": "newData.isNumber()"
    },
    "displayName": {
     ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
     ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length >= 1"
    },
    "minecraftUsername": {
     ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
     ".validate": "newData.isString() && newData.val().length <= 32"
    },
    "avatar": {
     ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "bio": {
     ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
     ".validate": "newData.isString() && newData.val().length <= 300"
    },
    "favorites": {
     "$pid": {
      ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
      ".validate": "newData.val() === true"
     }
    },
    "following": {
     "$cid": {
      ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
      ".validate": "newData.val() === true && $cid !== auth.uid"
     }
    },
    "notifications": {
     "$nid": {
      ".write": "auth != null && auth.uid === $uid && data.exists()",
      "read": {
       ".validate": "newData.isBoolean()"
      },
      "$other": {
       ".validate": "false"
      }
     }
    }
   }
  },
  "usernames": {
   "$n": {
    ".read": true,
    ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
    ".validate": "$n.matches(/^[a-z0-9_]{3,20}$/) && newData.isString()"
   }
  },
  "publicProfiles": {
   "$uid": {
    ".read": true,
    ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
    ".validate": "newData.hasChildren(['username'])",
    "username": {
     ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
    },
    "displayName": {
     ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length >= 1"
    },
    "minecraftUsername": {
     ".validate": "newData.isString() && newData.val().length <= 32"
    },
    "avatar": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "$o": {
     ".validate": "false"
    }
   }
  },
  "catalog": {
   ".read": true,
   ".write": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')",
   "categories": {
    "$id": {
     ".validate": "newData.hasChildren(['name','edition','enabled','order'])",
     "name": {
      ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().length >= 1"
     },
     "edition": {
      ".validate": "newData.val() === 'java' || newData.val() === 'bedrock' || newData.val() === 'both'"
     },
     "logo": {
      ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
     },
     "enabled": {
      ".validate": "newData.isBoolean()"
     },
     "order": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "true"
     }
    }
   },
   "platforms": {
    "$id": {
     ".validate": "newData.hasChildren(['name','kind','enabled','order'])",
     "name": {
      ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().length >= 1"
     },
     "kind": {
      ".validate": "newData.val() === 'loader' || newData.val() === 'software' || newData.val() === 'distribution'"
     },
     "logo": {
      ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
     },
     "enabled": {
      ".validate": "newData.isBoolean()"
     },
     "order": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "true"
     }
    }
   },
   "mcVersions": {
    "$id": {
     ".validate": "newData.hasChildren(['edition','enabled'])",
     "$o": {
      ".validate": "true"
     }
    }
   }
  },
  "site": {
   ".read": true,
   ".write": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')",
   "socials": {
    "$id": {
     ".validate": "!newData.exists() || newData.hasChildren(['name','url','enabled','order'])",
     "name": {
      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
     },
     "url": {
      ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^(https?:\\/\\/|mailto:)[^\\s]+$/)"
     },
     "icon": {
      ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
     },
     "enabled": {
      ".validate": "newData.isBoolean()"
     },
     "order": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "false"
     }
    }
   },
   "banners": {
    "$id": {
     ".validate": "!newData.exists() || newData.hasChildren(['title','image','enabled','order'])",
     "title": {
      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
     },
     "description": {
      ".validate": "newData.isString() && newData.val().length <= 300"
     },
     "image": {
      ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
     },
     "link": {
      ".validate": "newData.isString() && newData.val().length <= 500"
     },
     "category": {
      ".validate": "newData.isString() && newData.val().length <= 40"
     },
     "enabled": {
      ".validate": "newData.isBoolean()"
     },
     "order": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "false"
     }
    }
   },
   "brand": {
    "logo": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "favicon": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "projectIcon": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "avatar": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "siteName": {
     ".validate": "newData.isString() && newData.val().length <= 60"
    },
    "tagline": {
     ".validate": "newData.isString() && newData.val().length <= 160"
    },
    "$o": {
     ".validate": "false"
    }
   }
  },
  "projects": {
   "$pid": {
    ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com'))",
    ".write": "auth != null && root.child('users').child(auth.uid).child('suspended').val() !== true && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || ((!data.exists() ? (((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || root.child('users').child(auth.uid).child('role').val() === 'developer') && newData.child('ownerUid').val() === auth.uid) : data.child('ownerUid').val() === auth.uid) && (!newData.exists() || ((newData.child('status').val() === 'draft' || newData.child('status').val() === 'pending') && (!data.exists() || newData.child('ownerUid').val() === data.child('ownerUid').val())))))",
    ".validate": "newData.hasChildren(['name','ownerUid','category','edition','status','updatedAt'])",
    "name": {
     ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().length >= 3"
    },
    "description": {
     ".validate": "newData.isString() && newData.val().length <= 400"
    },
    "readme": {
     ".validate": "newData.isString() && newData.val().length <= 20000"
    },
    "icon": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "banner": {
     ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
    },
    "screenshots": {
     "$i": {
      ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().matches(/^https?:\\/\\/[^\\s]+$/))"
     }
    },
    "category": {
     ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().length >= 1"
    },
    "edition": {
     ".validate": "newData.val() === 'java' || newData.val() === 'bedrock'"
    },
    "license": {
     ".validate": "newData.isString() && newData.val().length <= 40"
    },
    "ownerUid": {
     ".validate": "newData.isString()"
    },
    "ownerName": {
     ".validate": "newData.isString() && newData.val().length <= 40"
    },
    "status": {
     ".validate": "newData.isString()"
    },
    "updatedAt": {
     ".validate": "newData.isNumber()"
    },
    "createdAt": {
     ".validate": "newData.isNumber()"
    },
    "tags": {
     "$i": {
      ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length >= 1"
     }
    },
    "dependencies": {
     "$i": {
      ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().length >= 1"
     }
    },
    "$o": {
     ".validate": "true"
    }
   },
   ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || (query.orderByChild === 'ownerUid' && query.equalTo === auth.uid))",
   ".indexOn": [
    "ownerUid",
    "status"
   ]
  },
  "projectsPublic": {
   ".read": true,
   ".indexOn": [
    "downloads",
    "updatedAt",
    "category"
   ],
   "$pid": {
    ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || (!newData.exists() && root.child('projects').child($pid).child('ownerUid').val() === auth.uid))"
   }
  },
  "projectVersions": {
   "$pid": {
    ".read": "root.child('projectsPublic').child($pid).exists() || (auth != null && (root.child('projects').child($pid).child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')))",
    "$vid": {
     ".write": "auth != null && root.child('users').child(auth.uid).child('suspended').val() !== true && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || root.child('projects').child($pid).child('ownerUid').val() === auth.uid)",
     ".validate": "!newData.exists() || newData.hasChildren(['version','mc','platforms','createdAt'])",
     "version": {
      ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length >= 1"
     },
     "changelog": {
      ".validate": "newData.isString() && newData.val().length <= 5000"
     },
     "createdAt": {
      ".validate": "newData.isNumber()"
     },
     "mc": {
      "$m": {
       ".validate": "newData.val() === true"
      }
     },
     "platforms": {
      "$p": {
       ".validate": "newData.val() === true"
      }
     },
     "$o": {
      ".validate": "false"
     }
    }
   }
  },
  "projectFiles": {
   "$pid": {
    ".read": "auth != null && (root.child('projectsPublic').child($pid).exists() || root.child('projects').child($pid).child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com'))"
   }
  },
  "reviews": {
   "$pid": {
    ".read": true,
    "$uid": {
     ".write": "((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')) || (auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true && root.child('projectsPublic').child($pid).exists())",
     ".validate": "!newData.exists() || newData.hasChildren(['stars','text','createdAt'])",
     "stars": {
      ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
     },
     "text": {
      ".validate": "newData.isString() && newData.val().length <= 2000"
     },
     "userName": {
      ".validate": "newData.isString() && newData.val().length <= 40"
     },
     "createdAt": {
      ".validate": "newData.isNumber()"
     },
     "updatedAt": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "false"
     }
    }
   }
  },
  "reviewVotes": {
   "$pid": {
    ".read": true,
    "$ruid": {
     "$voter": {
      ".write": "auth != null && auth.uid === $voter && $ruid !== auth.uid && root.child('users').child(auth.uid).child('suspended').val() !== true",
      ".validate": "newData.isBoolean()"
     }
    }
   }
  },
  "comments": {
   "$pid": {
    ".read": true,
    "$cid": {
     ".write": "auth != null && root.child('users').child(auth.uid).child('suspended').val() !== true && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || root.child('projects').child($pid).child('ownerUid').val() === auth.uid)))",
     ".validate": "!newData.exists() || newData.hasChildren(['uid','text','createdAt'])",
     "uid": {
      ".validate": "newData.isString()"
     },
     "userName": {
      ".validate": "newData.isString() && newData.val().length <= 40"
     },
     "text": {
      ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().length >= 1"
     },
     "createdAt": {
      ".validate": "newData.isNumber()"
     },
     "$o": {
      ".validate": "false"
     }
    }
   }
  },
  "reports": {
   ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')",
   "$rid": {
    ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com') || (!data.exists() && newData.child('by').val() === auth.uid && root.child('users').child(auth.uid).child('suspended').val() !== true))",
    ".validate": "newData.hasChildren(['type','target','reason','by','createdAt'])",
    "type": {
     ".validate": "newData.val() === 'project' || newData.val() === 'review' || newData.val() === 'comment' || newData.val() === 'user'"
    },
    "target": {
     ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().length >= 1"
    },
    "reason": {
     ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().length >= 1"
    },
    "by": {
     ".validate": "newData.isString()"
    },
    "createdAt": {
     ".validate": "newData.isNumber()"
    },
    "status": {
     ".validate": "newData.isString()"
    },
    "$o": {
     ".validate": "false"
    }
   }
  },
  "developerApplications": {
   ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'atarafatyt1@gmail.com')",
   "$uid": {
    ".read": "auth != null && auth.uid === $uid",
    ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('suspended').val() !== true && newData.child('status').val() === 'pending' && (!data.exists() || data.child('status').val() !== 'approved')",
    ".validate": "newData.hasChildren(['name','pitch','status','createdAt'])",
    "name": {
     ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().length >= 1"
    },
    "pitch": {
     ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().length >= 1"
    },
    "links": {
     ".validate": "newData.isString() && newData.val().length <= 500"
    },
    "status": {
     ".validate": "newData.isString()"
    },
    "createdAt": {
     ".validate": "newData.isNumber()"
    },
    "$o": {
     ".validate": "false"
    }
   }
  },
  "uploads": {
   "$uid": {
    ".read": "auth != null && auth.uid === $uid"
   }
  }
 }
}